#!/usr/bin/python3
"""Refresh Argos-owned runtime files masked by live persistence."""
import sys

# Prefer this boot's immutable package. /usr/local/lib may be an older copy in
# the persistence upper layer that this service is responsible for refreshing.
sys.path.insert(0, '/run/live/rootfs/filesystem.squashfs/usr/local/lib/argos-live')
from argoslive.image_refresh import main

raise SystemExit(main())
