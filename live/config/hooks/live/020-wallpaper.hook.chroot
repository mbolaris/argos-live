#!/bin/sh
set -eu
# XFCE's initial monitor settings use this desktop-base default path.
# Keep an explicitly chosen user wallpaper intact by changing the default asset.
wallpaper=/usr/share/backgrounds/argos-live/futuristic-coastline.png
test -s "$wallpaper"
mkdir -p /usr/share/images/desktop-base
ln -sfn "$wallpaper" /usr/share/images/desktop-base/default
# XFCE 4.20 uses this packaged fallback when legacy monitor migration fails.
# GdkPixbuf detects the supplied PNG from its signature through the symlink.
if [ -e /usr/share/backgrounds/xfce/xfce-x.svg ]; then
  ln -sfn "$wallpaper" /usr/share/backgrounds/xfce/xfce-x.svg
fi
