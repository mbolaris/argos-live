[Unit]
Description=Refresh Argos runtime files from the current live image
After=local-fs.target
Before=display-manager.service
ConditionPathExists=/run/live/rootfs/filesystem.squashfs/usr/local/bin/argos

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /run/live/rootfs/filesystem.squashfs/usr/local/sbin/argos-refresh-runtime
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
